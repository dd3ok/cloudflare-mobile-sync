{
  "name": "@cloudflare-mobile-sync/worker",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "wrangler deploy --dry-run --outdir dist",
    "build:ant-hell": "wrangler deploy --dry-run --config wrangler.ant-hell.jsonc --outdir dist/ant-hell",
    "deploy:ant-hell": "wrangler deploy --config wrangler.ant-hell.jsonc",
    "dev": "wrangler dev",
    "migrate:local": "wrangler d1 migrations apply DB --local",
    "migrate:remote": "wrangler d1 migrations apply cloudflare-mobile-sync-prod --remote",
    "migrate:ant-hell:remote": "wrangler d1 migrations apply ant-hell-sync-prod --remote --config wrangler.ant-hell.jsonc",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "types": "wrangler types"
  },
  "dependencies": {
    "@better-auth/expo": "1.6.23",
    "@cloudflare-mobile-sync/api-contract": "workspace:*",
    "better-auth": "1.6.23",
    "hono": "4.12.34",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.18.6",
    "@cloudflare/workers-types": "5.20260719.1",
    "auth": "1.6.23",
    "vitest": "4.1.10",
    "wrangler": "4.112.0"
  }
}
