# Worker-only local configuration. Copy this file to `.dev.vars` in this
# directory. Never copy these values into a consuming app.
ALLOWED_COLLECTIONS=notes
BETTER_AUTH_URL=http://localhost:8787
TRUSTED_ORIGINS=com.example.cloudflaremobilesync://

# Server-only secrets. Replace the placeholders locally; `.dev.vars` is ignored.
BETTER_AUTH_SECRET=replace-with-32-or-more-random-bytes
# Use the same value at version 1 on a new install. Put the newest version first when rotating.
BETTER_AUTH_SECRETS=1:replace-with-the-same-random-secret

# GOOGLE_WEB_CLIENT_ID and NATIVE_APPLICATION_ID are public deployment metadata.
# Keep them in Wrangler vars rather than duplicating them in this secret file.
