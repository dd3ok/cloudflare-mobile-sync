# Copy to `.env.production` for the first deployment. The real file is ignored
# by Git and is uploaded only as encrypted Worker secrets.
BETTER_AUTH_SECRET=replace-with-32-or-more-random-bytes
# Use the same initial secret as BETTER_AUTH_SECRET, prefixed with version 1.
BETTER_AUTH_SECRETS=1:replace-with-the-same-random-secret

# Add a provider only when both real values and its callback are configured.
# GOOGLE_CLIENT_ID=replace-with-google-client-id
# GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
# KAKAO_CLIENT_ID=replace-with-kakao-client-id
# KAKAO_CLIENT_SECRET=replace-with-kakao-client-secret
# NAVER_CLIENT_ID=replace-with-naver-client-id
# NAVER_CLIENT_SECRET=replace-with-naver-client-secret
