{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pending-byulsataro-sync-preview",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-20",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "triggers": { "crons": ["* * * * *"] },
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pending-byulsataro-sync-preview",
      "database_id": "00000000-0000-0000-0000-000000000002",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "9201",
      "simple": { "limit": 60, "period": 60 }
    },
    {
      "name": "SYNC_RATE_LIMITER",
      "namespace_id": "9202",
      "simple": { "limit": 120, "period": 60 }
    }
  ],
  "vars": {
    "ALLOWED_COLLECTIONS": "byeolsataro-preview-birth-profile-v2,byeolsataro-preview-app-settings-v2,byeolsataro-preview-saved-readings-v2",
    "RETAINED_TOMBSTONE_TARGETS": "byeolsataro-preview-birth-profile-v2|profile-lineage|byeolsataro-preview|byeolsataro.profile-lineage/v2|2",
    "BETTER_AUTH_URL": "https://preview.pending.invalid",
    "TRUSTED_ORIGINS": "com.ponntailstudio.byulsataro.preview://"
  }
}
