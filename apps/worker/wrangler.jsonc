{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cloudflare-mobile-sync",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-20",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": false
    }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cloudflare-mobile-sync-prod",
      "database_id": "c0abc067-9ffa-4eb6-9496-d7117ccac23a",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "1003",
      "simple": {
        "limit": 60,
        "period": 60
      }
    },
    {
      "name": "SYNC_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ],
  "vars": {
    "ALLOWED_COLLECTIONS": "saved-readings-v1,app-settings-v1",
    "BETTER_AUTH_URL": "https://cloudflare-mobile-sync.ponntailstudio.workers.dev",
    "TRUSTED_ORIGINS": "com.byeolsata.app.dev://,com.byeolsata.app.preview://,com.byeolsata.app://"
  }
}
