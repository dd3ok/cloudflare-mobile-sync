{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "cloudflare-mobile-sync",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-20",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cloudflare-mobile-sync-prod",
      "database_id": "c0abc067-9ffa-4eb6-9496-d7117ccac23a",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "SYNC_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ],
  "secrets": {
    "required": ["BETTER_AUTH_SECRET", "BETTER_AUTH_SECRETS"]
  },
  "vars": {
    "ALLOWED_COLLECTIONS": "notes",
    "BETTER_AUTH_URL": "https://cloudflare-mobile-sync.ponntailstudio.workers.dev",
    "TRUSTED_ORIGINS": "byeolsata-dev://,byeolsata-preview://,byeolsata://"
  }
}
