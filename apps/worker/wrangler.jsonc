{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cloudflare-mobile-sync-example",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-20",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "triggers": { "crons": ["* * * * *"] },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": false
    }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cloudflare-mobile-sync-example",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "1003",
      "simple": {
        "limit": 60,
        "period": 60
      }
    },
    {
      "name": "SYNC_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ],
  "vars": {
    "ALLOWED_COLLECTIONS": "notes-v1,app-settings-v1",
    "BETTER_AUTH_URL": "https://sync.example.com",
    "GOOGLE_WEB_CLIENT_ID": "123456789-cloudflare-mobile-sync.apps.googleusercontent.com",
    "NATIVE_APPLICATION_ID": "com.example.cloudflaremobilesync",
    "TRUSTED_ORIGINS": "com.example.cloudflaremobilesync://"
  }
}
